<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: outbound is only used to fetch the public blocklist file. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Persistent core service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Restart everything after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ongoing notification for the core service and Stage 3 detection
         notifications on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Stage 6: launch Reflection Mode full-screen, over the keyguard, on a lock.
         Granted at install below Android 14; on 14+ the user confirms it once
         (ReflectionLauncher.needsFullScreenIntentGrant + the settings-link button). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Fast Scan Apps picker: Android 11+ package visibility for launchable apps
         (their labels and icons), without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Device administration (Device Owner is provisioned via ADB, see README). -->
    <uses-feature
        android:name="android.software.device_admin"
        android:required="true" />

    <application
        android:name=".RafiqApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Guardian"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Rafiq.Main"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Rafiq.Main" />

        <activity
            android:name=".FastScanAppsActivity"
            android:exported="false"
            android:theme="@style/Theme.Rafiq.Main"
            android:parentActivityName=".MainActivity" />

        <!-- Stage 6: Reflection Mode. The pinned full-screen reminder shown on a lock.
             excludeFromRecents + singleInstance so it owns the task it pins; shows over
             the keyguard; its own task so FLAG_ACTIVITY_NEW_TASK launches it clean. -->
        <activity
            android:name=".reflection.ReflectionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Guardian.Reflection"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".reflection.ReflectionSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Rafiq.Main"
            android:parentActivityName=".MainActivity" />

        <!-- Stage 1: Device Admin / Device Owner receiver.
             Provisioned with:
               adb shell dpm set-device-owner \
                 com.personal.guardian/.admin.GuardianDeviceAdminReceiver -->
        <receiver
            android:name=".admin.GuardianDeviceAdminReceiver"
            android:description="@string/admin_description"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Stage 1: core persistent foreground service (base for later stages). -->
        <service
            android:name=".service.GuardianForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on_device_content_accountability" />
        </service>

        <!-- Stage 2: local DNS-filtering VPN. -->
        <service
            android:name=".vpn.GuardianVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Stage 3: screen scanning. Enabled by the user once in
             Settings → Accessibility → Installed apps → Guardian. -->
        <service
            android:name=".scan.GuardianAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Restart core service + filtering on boot. -->
        <receiver
            android:name=".boot.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme built on a Material 3 DayNight parent so it adapts to the
         system light/dark setting without a separate values-night file. -->
    <style name="Theme.Guardian" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/guardian_primary</item>
        <item name="colorPrimaryVariant">@color/guardian_primary_dark</item>
        <item name="colorSecondary">@color/guardian_accent</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/guardian_primary_dark</item>
    </style>
</resources>
